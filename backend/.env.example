# URL do seu projeto Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxx.supabase.co/rest/v1/

# service_role key (Project Settings > API > service_role secret)
# NUNCA exponha essa chave no frontend, só o backend deve usá-la.
SUPABASE_SERVICE_KEY=sua-service-role-key-aqui

# Porta do servidor
PORT=3001

# URL do frontend, usada para liberar CORS (coloque a URL da Vercel quando fizer o deploy)
FRONTEND_URL=http://localhost:5173

# Chaves VAPID para notificação push — gere as suas com:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contas de admin — gere o hash de cada senha com:
# node -e "console.log(require('bcryptjs').hashSync('sua-senha', 10))"
# Pra adicionar mais contas, segue o mesmo padrão: ADMIN3_USERNAME, ADMIN3_PASSWORD_HASH...
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

ADMIN2_USERNAME=
ADMIN2_PASSWORD_HASH=

# Chave aleatória pra assinar o token de login — gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
