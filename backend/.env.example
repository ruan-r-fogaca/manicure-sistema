# URL do seu projeto Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxx.supabase.co/rest/v1/

# service_role key (Project Settings > API > service_role secret)
# NUNCA exponha essa chave no frontend, só o backend deve usá-la.
SUPABASE_SERVICE_KEY=sua-service-role-key-aqui

# Porta do servidor
PORT=3001

# URL do frontend, usada para liberar CORS (coloque a URL da Vercel quando fizer o deploy)
FRONTEND_URL=http://localhost:5173
